# OpenRouter — required for live guide generation
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override default model (openai/gpt-4o-mini)
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: OpenRouter web search (research phase) — billed by OpenRouter
# Plugin: native | exa | firecrawl | parallel | perplexity (omit/auto = OpenRouter default)
# Server tool also accepts auto
# OPENROUTER_WEB_SEARCH_ENGINE=exa
# OPENROUTER_WEB_SEARCH_MAX_RESULTS=5

# Optional: OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=OAuth Readiness
